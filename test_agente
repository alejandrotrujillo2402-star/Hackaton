    assert r.status_code == 200 and "SpeechRecognition" in r.text


# ---------- MEMORIA ----------
def test_historial_reconstruye_chat():
    memoria.registrar_cliente("4445556", "Luis")
    memoria.guardar_mensajes("4445556", [
        {"role": "user", "content": "hola"},
        {"role": "assistant", "content": None,
         "tool_calls": [{"id": "a", "type": "function", "function": {"name": "mis_citas", "arguments": "{}"}}]},
        {"role": "tool", "tool_call_id": "a", "content": "{}"},
        {"role": "assistant", "content": "listo"},
    ])
    chat = memoria.a_chat(memoria.cargar_historial("4445556"))
    assert [c[0] for c in chat] == ["user", "assistant"]
    assert "mis_citas" in chat[1][2][0]


# ---------- ESCALAMIENTO ----------
def test_escalamiento_se_registra(cliente):
    args = {"motivo": "Cita no asignada", "emocion": "enojado", "urgencia": 4,
            "resumen": "El afiliado no logra cita con ortopedia hace un mes.", "pendiente": "Asignar cita"}
    r = motor._ejecutar(tool_call("escalar_a_humano", args), F, cliente)
    assert r["escalado"] and r["ticket"].startswith("ESC-")
    assert any(e["ticket"] == r["ticket"] and e["emocion"] == "enojado" for e in escalamiento.listar_escalamientos())


