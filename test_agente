def test_herramienta_desconocida_no_rompe(cliente):
    assert "error" in motor._ejecutar(tool_call("borrar_todo", {}), F, cliente)


def test_loop_encadena_herramientas(monkeypatch):
    guion = iter([
        respuesta(MensajeFalso(tool_calls=[tool_call("consultar_disponibilidad", {"especialidad": "pediatria"})])),
        respuesta(MensajeFalso(content="Hay horarios mañana")),
    ])
    monkeypatch.setattr(motor, "llamar", lambda **_: next(guion))
    msgs = [{"role": "user", "content": "¿Hay citas de pediatría?"}]
    texto, pasos = motor.correr_agente(msgs, dominio.TOOLS, F)
    assert texto == "Hay horarios mañana"
    assert "consultar_disponibilidad" in pasos[0] and "horarios" in pasos[0]
    assert msgs[-1]["role"] == "assistant"


def test_limite_de_pasos(monkeypatch):
    monkeypatch.setattr(motor, "llamar", lambda **_: respuesta(
        MensajeFalso(tool_calls=[tool_call("consultar_disponibilidad", {"especialidad": "pediatria"})])))
    texto, pasos = motor.correr_agente([{"role": "user", "content": "x"}], dominio.TOOLS, F, max_pasos=3)
    assert "límite" in texto and len(pasos) == 3


def test_limpia_restos_internos_del_modelo():
    assert motor.limpiar("seethought Lamento mucho") == "Lamento mucho"
    assert motor.limpiar("<thought>pienso</thought>Hola") == "Hola"
    assert motor.limpiar("Pensé en tu caso") == "Pensé en tu caso"


